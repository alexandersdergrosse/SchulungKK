<!DOCTYPE html>
<html lang = "de">

<head>
    <meta charset = "utf-8" />

    <meta name = "viewport" content = "width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SchulungKK</title>

    <link rel = "stylesheet" href = "~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel = "stylesheet" href = "~/css/site.css" asp-append-version = "true" />

    <link rel = "stylesheet" href = "~/SchulungKK.styles.css" asp-append-version = "true" />

    <link rel = "icon" type = "image/png" href = "~/images/logok.png" />
</head>

<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

        var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";

        var username = Context.Session.GetString("Username") ?? "Benutzer";

        var isAdmin = Context.Session.GetString("IsAdmin") == "true";
    }

    <header>
        <nav class = "navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">
            <div class = "container-fluid px-3 px-lg-4">

                <!-- Logo -->
                <a class = "navbar-brand header-brand" asp-page = "/Index">

                    <img src = "~/images/kt-logo.png" class = "header-logo" alt = "Kreutzträger Firmenlogo" />
                </a>

                <!-- Mobiler Menübutton -->
                <button class = "navbar-toggler" type = "button" data-bs-toggle = "collapse" data-bs-target = "#mainNavigation" aria-controls = "mainNavigation"  aria-expanded = "false"  aria-label = "Navigation öffnen">

                    <span class = "navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class = "collapse navbar-collapse" id = "mainNavigation">

                    <ul class = "navbar-nav ms-auto align-items-lg-center">

                        @if (isLoggedIn)
                        {
                            <!-- Benutzermenü -->
                            <li class = "nav-item dropdown ms-lg-3">
                                <a class = "nav-link dropdown-toggle user-menu-link" href = "#" id = "userDropdown" role = "button" data-bs-toggle = "dropdown" aria-expanded = "false">

                                    👤 @username
                                </a>

                                <ul class = "dropdown-menu dropdown-menu-end" aria-labelledby = "userDropdown">

                                    <li>
                                        <h6 class = "dropdown-header">
                                            Angemeldet als
                                            <br />
                                            <strong>@username</strong>
                                        </h6>
                                    </li>

                                    <li>
                                        <hr class = "dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class = "dropdown-item" asp-page = "/Index">

                                            🏠 Startseite
                                        </a>
                                    </li>

                                    <li>
                                        <a class = "dropdown-item" asp-page = "/Konto">

                                            👤 Konto
                                        </a>
                                    </li>

                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class = "dropdown-item" asp-page = "/Admin/Index">
                                                🛠️ Administration
                                            </a>
                                        </li>

                                        <li>
                                            <hr class = "dropdown-divider" />
                                        </li>
                                    }

                                    <li>
                                        <a class = "dropdown-item" asp-page = "/Ergebnisse">

                                            📊 Meine Ergebnisse
                                        </a>
                                    </li>

                                    <li>
                                        <hr class = "dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class = "dropdown-item text-danger" asp-page = "/Abmelden">

                                            🚪 Abmelden
                                        </a>
                                    </li>
                                </ul>
                            </li>
                                                }
                        else
                        {
                            <li class = "nav-item">
                                <a class = "nav-link @(currentPage == "/Anmelden" ? "active" : "")" asp-page = "/Anmelden">

                                    Anmelden
                                </a>
                            </li>

                            <li class = "nav-item ms-lg-2">
                                <a class = "btn btn-outline-primary register-link @(currentPage == "/Registrieren" ? "active" : "")" asp-page = "/Registrieren">

                                    Registrieren
                                </a>
                            </li>
                                                }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role = "main" class = "page-content">
        @RenderBody()
    </main>

    <script src = "~/lib/jquery/dist/jquery.min.js"></script>

    <script src = "~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src = "~/js/site.js" asp-append-version = "true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>