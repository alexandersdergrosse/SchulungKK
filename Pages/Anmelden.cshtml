@page
@model AnmeldenModel
@{
    ViewData["Title"] = "Anmeldung";
}

<!--Hier melden sich die Kunden an-->
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg">
            <div class="card-body p-5">

                <!-- Logo / Icon -->
                <div class="text-center mb-4">
                    <div style="font-size: 60px; color: #0066cc;">🔐</div>
                    <h2 class="mt-3">Anmelden</h2>
                    <p class="text-muted">Bitte melden Sie sich an</p>
                </div>

                <!-- Login Formular -->
                <form method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label fw-bold">Benutzername</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="username"
                               name="username"
                               asp-for="Username"
                               required
                               placeholder="Benutzername eingeben">
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-bold">Passwort</label>
                        <input type="password"
                               class="form-control form-control-lg"
                               id="password"
                               name="password"
                               asp-for="Password"
                               required
                               placeholder="Passwort eingeben">
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Anmelden
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted mb-0">
                        Noch kein Konto?
                        <a asp-page="/Registrieren" class="text-decoration-none">Jetzt registrieren</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Karte ohne Rahmen, schöne Rundungen */
    .card {
        border: none;
        border-radius: 15px;
    }

    /* Eingabefelder beim Fokus blau umranden */
    .form-control:focus {
        border-color: #0066cc;
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    /* Button Hover-Effekt */
    .btn-primary {
        background: linear-gradient(135deg, #0066cc 0%, #004999 100%);
        border: none;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 102, 204, 0.4);
        transition: all 0.3s;
    }
</style>