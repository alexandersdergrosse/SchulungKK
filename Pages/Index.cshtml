@page
@model IndexModel
@{}

<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video mit Quiz</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        video {
            width: 100%;
            height: auto;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        #quiz {
            display: none;
        }

        .quiz-question {
            background: #f9f9f9;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            border-left: 4px solid #007bff;
        }

            .quiz-question h3 {
                margin-top: 0;
                color: #333;
            }

        .quiz-option {
            display: block;
            padding: 12px;
            margin: 8px 0;
            background: white;
            border: 2px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .quiz-option:hover {
                background: #e3f2fd;
                border-color: #007bff;
            }

            .quiz-option input[type="radio"] {
                margin-right: 10px;
            }

        .submit-btn {
            background: #007bff;
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
        }

            .submit-btn:hover {
                background: #0056b3;
            }

        #result {
            display: none;
            padding: 20px;
            margin-top: 20px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
        }

        .correct {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }

        .incorrect {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center">Schulungsvideo</h1>

        <video id="myVideo" controls>
            <source src="videos/Imagefilm.mp4" type="video/mp4">
            Dein Browser unterstützt das Video-Tag nicht.
        </video>

        <div id="quiz">
            <div class="loading">Quiz wird geladen...</div>
        </div>
    </div>

    <script>
        const video = document.getElementById('myVideo');
        const quizContainer = document.getElementById('quiz');
        let quizData = null;
        let correctAnswers = {};

        // Fragen aus JSON-Datei laden
        fetch('fragen.json')
            .then(response => response.json())
            .then(data => {
                quizData = data;
                createQuiz();
            })
            .catch(error => {
                console.error('Fehler beim Laden der Fragen:', error);
                quizContainer.innerHTML = '<p style="color: red;">Fehler beim Laden der Fragen. Bitte überprüfe die fragen.json Datei.</p>';
            });

        // Quiz erstellen
        function createQuiz() {
            let quizHTML = `
                <h2> ${quizData.titel}</h2>
                <p>${quizData.beschreibung}</p>
                <form id="quizForm">
            `;

            quizData.fragen.forEach((item, index) => {
                const questionNumber = index + 1;
                const questionName = `q${questionNumber}`;

                // Richtige Antwort speichern
                correctAnswers[questionName] = item.richtig;

                quizHTML += `
                    <div class="quiz-question">
                        <h3>${questionNumber}. ${item.frage}</h3>
                `;

                item.antworten.forEach((antwort, answerIndex) => {
                    quizHTML += `
                        <label class="quiz-option">
                            <input type="radio" name="${questionName}" value="${answerIndex}">
                            ${antwort}
                        </label>
                    `;
                });

                quizHTML += `</div>`;
            });

            quizHTML += `
                    <button type="submit" class="submit-btn">Quiz auswerten</button>
                </form>
                <div id="result"></div>
            `;

            quizContainer.innerHTML = quizHTML;

            // Event Listener für Formular
            document.getElementById('quizForm').addEventListener('submit', evaluateQuiz);
        }

        // Quiz auswerten
        function evaluateQuiz(e) {
            e.preventDefault();

            let score = 0;
            let total = Object.keys(correctAnswers).length;

            for (let question in correctAnswers) {
                const userAnswer = document.querySelector(`input[name="${question}"]:checked`);
                if (userAnswer && parseInt(userAnswer.value) === correctAnswers[question]) {
                    score++;
                }
            }

            const result = document.getElementById('result');
            result.style.display = 'block';
            const percentage = Math.round((score / total) * 100);

            if (percentage >= 70) {
                result.className = 'correct';
                result.innerHTML = `✅ Sehr gut! Du hast ${score} von ${total} Fragen richtig beantwortet (${percentage}%)`;
            } else {
                result.className = 'incorrect';
                result.innerHTML = `❌ Leider nicht bestanden. Du hast ${score} von ${total} Fragen richtig beantwortet (${percentage}%). Schau dir das Video nochmal an.`;
            }

            result.scrollIntoView({ behavior: 'smooth' });
        }

        // Quiz anzeigen wenn Video endet
        video.addEventListener('ended', function() {
            quizContainer.style.display = 'block';
            quizContainer.scrollIntoView({ behavior: 'smooth' });
        });
    </script>
</body>
</html>


